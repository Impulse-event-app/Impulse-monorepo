{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811502068",
        "appleTeamId": "546PY362R7"
      }
    },
    "staging": {
      "ios": {
        "ascAppId": "REPLACE_WITH_STAGING_ASC_APP_ID",
        "appleTeamId": "546PY362R7"
      }
    }
  }
}
