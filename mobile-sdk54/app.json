{
  "expo": {
    "name": "Impulse",
    "slug": "impulse",
    "version": "1.1.0",
    "scheme": "impulse",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Impulse uses your location while you set up, to suggest your home suburb. Never in the background.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Impulse doesn't use motion data. The permission is declared by the location library it uses, and your movement is never tracked or stored.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-contacts",
        { "contactsPermission": "Impulse checks which of your contacts are on Impulse so you can invite them. Numbers and emails are scrambled on your phone before they're checked, and never stored." }
      ],
      "expo-video",
      ["expo-widgets", { "enablePushNotifications": true, "frequentUpdates": true }],
      "expo-status-bar",
      [
        "@stripe/stripe-react-native",
        { "merchantIdentifier": "merchant.au.impulseapp.impulse", "enableGooglePay": true }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F1F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.impulseapp.impulse",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:impulse.expo.app"],
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Impulse uses the camera to scan your card when you add one.",
        "NSPhotoLibraryUsageDescription": "Impulse only opens your photo library if you choose a photo or video to use in the app."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] }
        ]
      }
    },
    "android": {
      "package": "au.impulseapp.impulse",
      "adaptiveIcon": {
        "backgroundColor": "#C80815",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "impulse.expo.app", "pathPrefix": "/huddle/join" },
            { "scheme": "https", "host": "impulse.expo.app", "pathPrefix": "/seat" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcd9318b-55fe-4ad0-83eb-18bb6e2f9232"
      }
    },
    "owner": "manojvradan"
  }
}
