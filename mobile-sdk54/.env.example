# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase — Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# FastAPI backend base URL (no trailing slash)
# Local dev: http://localhost:8000
# Production: https://api.yourapp.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Maps SDK for Android key — Google Cloud → enable "Maps SDK for Android"
# Only needed for native Android builds; Expo Go and iOS (Apple Maps) don't use it.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=<your-android-maps-key>

# Host for shared huddle links. Must serve public/.well-known/* and match
# ios.associatedDomains / android.intentFilters in app.json, or links open in
# the browser instead of the app.
EXPO_PUBLIC_WEB_URL=https://impulse.expo.app

# Where a huddle link sends people who don't have the app (opened on the web).
# Swap for the App Store / Play Store listing once published.
EXPO_PUBLIC_APP_FALLBACK_URL=https://impulseapp.au
