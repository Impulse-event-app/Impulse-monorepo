# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase Postgres connection string (URI form, port 5432)
# Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=

# Supabase project URL. Used to fetch the JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json for verifying user JWTs (RS256).
# Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Supabase service_role key. Server-only — it bypasses RLS, so never ship it to
# a client. Used for one thing: deleting the auth user when someone deletes
# their account in the app (DELETE /users/me, required by App Store review).
# Without it that endpoint returns 503.
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# ── Stripe (Connect marketplace) ──────────────────────────────────────────────
# Test vs live is decided by the key alone. Use a RESTRICTED key (rk_test_… /
# rk_live_…) from Developers → API keys, scoped to what the backend calls:
# PaymentIntents, SetupIntents, Customers, CustomerSessions, PaymentMethods,
# Refunds, Balance, Payouts, Accounts v2, Account Sessions.
# Develop against a Stripe sandbox, not the shared test mode.
STRIPE_SECRET_KEY=
# One signing secret per event destination (Developers → Webhooks):
#   /webhooks/stripe           your account: payment_intent.amount_capturable_updated,
#                              setup_intent.succeeded, payment_intent.payment_failed,
#                              charge.dispute.created
#   /webhooks/stripe/connect   connected accounts: payout.paid, payout.failed, payout.canceled
#   /webhooks/stripe/accounts  thin events: v2.core.account[configuration.recipient].capability_status_updated,
#                              v2.core.account[requirements].updated
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNTS_WEBHOOK_SECRET=
# The publishable key (pk_…) is not used here; the apps read it as
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY (mobile) and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (venue-web).

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Provider-agnostic: Google Workspace app password, Resend, Postmark, Mailgun
# and SES all work. REQUIRED IN PRODUCTION — with these unset, mailer says it is
# not configured and two things fail quietly: venue enquiries to /api/contact
# return 502, and "you're verified" / "Stripe needs more" venue emails are never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when blank.
SMTP_FROM=

# Who receives venue enquiries. Comma-separated.
# Defaults to rahul@impulseapp.au,manoj@impulseapp.au when unset — override in
# staging so test enquiries do not reach the real inbox.
VENUE_ENQUIRY_TO=

# ── Optional tuning ───────────────────────────────────────────────────────────
# Max venue enquiries per IP per hour. Default 5.
CONTACT_RATE_LIMIT=

# Seconds between in-process huddle deadline sweeps. Default 60; set 0 to
# disable and rely on external cron / sweep_huddles.py. Set 0 on every extra
# instance if this service is ever scaled beyond one, or they all sweep at once.
HUDDLE_SWEEP_INTERVAL=

# Waitlist stats endpoint — any long random string
WAITLIST_STATS_API_KEY=
