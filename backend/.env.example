# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase Postgres connection string (URI form, port 5432)
# Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=

# Supabase project URL. Used to fetch the JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json for verifying user JWTs (RS256).
# Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# ── Pinch Payments (https://docs.getpinch.com.au) ─────────────────────────────
# Application Id + Secret Key from the Pinch portal — exchanged via OAuth2
# client credentials for a 1-hour Bearer token. The SAME credentials work in
# test and live; only PINCH_BASE_URL decides which environment you are in.
PINCH_CLIENT_ID=
PINCH_API_KEY=
# Test API base; switch to https://api.getpinch.com.au/live for production.
# Note: managed merchants created against /test come back testOnlyMerchant=true,
# so a venue onboarded in test must be onboarded again against live.
PINCH_BASE_URL=https://api.getpinch.com.au/test
# The master merchant every charge currently runs through (Current-Merchant
# header). Historically named "TEST" but it is the real merchant in live mode
# too — the name is kept only because four modules read it at import.
PINCH_TEST_MERCHANT_ID=

# Public base URL Pinch calls back on for managed-merchant compliance updates.
# Must be publicly reachable HTTPS — the webhook uri is baked in when a merchant
# is created and Pinch will not retry it into existence later, so a localhost
# value leaves that merchant permanently unreachable.
# If unset, the code falls back to the incoming request's own host, which behind
# a TLS-terminating proxy can resolve to http:// and be rejected as unreachable,
# silently skipping webhook registration. Set it explicitly in production.
PINCH_WEBHOOK_BASE_URL=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Provider-agnostic: Google Workspace app password, Resend, Postmark, Mailgun
# and SES all work. REQUIRED IN PRODUCTION — with these unset, mailer says it is
# not configured and two things fail quietly: venue enquiries to /api/contact
# return 502, and managed-merchant approval/rejection emails are never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when blank.
SMTP_FROM=

# Who receives venue enquiries. Comma-separated.
# Defaults to rahul@impulseapp.au,manoj@impulseapp.au when unset — override in
# staging so test enquiries do not reach the real inbox.
VENUE_ENQUIRY_TO=

# ── Optional tuning ───────────────────────────────────────────────────────────
# Max venue enquiries per IP per hour. Default 5.
CONTACT_RATE_LIMIT=

# Seconds between in-process huddle deadline sweeps. Default 60; set 0 to
# disable and rely on external cron / sweep_huddles.py. Set 0 on every extra
# instance if this service is ever scaled beyond one, or they all sweep at once.
HUDDLE_SWEEP_INTERVAL=

# Waitlist stats endpoint — any long random string
WAITLIST_STATS_API_KEY=
