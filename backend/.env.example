# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase Postgres — Supabase Dashboard → Settings → Database → Connection string (URI, port 5432)
DATABASE_URL=postgresql://postgres:<your-db-password>@db.ihxaejkvyowkdzynhhuv.supabase.co:5432/postgres

# Supabase JWT secret — Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
